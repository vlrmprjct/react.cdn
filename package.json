{
    "name": "react.cdn",
    "version": "1.0.1",
    "description": "React App using CDN",
    "scripts": {
        "start": "npm run transform -- --watch=forever --serve --servedir=dist --sourcemap",
        "start:live": "npx concurrently 'npm run start' 'npx live-server dist'",
        "build": "rm -rf dist/*.js dist/*.css && npm run transform -- --minify --analyze --metafile=dist/metafile.json",
        "transform": "npx esbuild index.js app.css --bundle --outdir=dist --loader:.js=jsx --loader:.css=css"
    },
    "keywords": [
        "React",
        "CDN",
        "Javascript"
    ],
    "author": "Thomas Meschke <mail@lokalnetz.com>",
    "repository": "https://github.com/vlrmprjct/react.cdn",
    "license": "MIT"
}